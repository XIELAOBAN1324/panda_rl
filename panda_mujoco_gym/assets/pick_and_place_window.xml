<mujoco model="panda scene">
    <compiler angle="radian" meshdir="./meshes/" autolimits="true"/>

    <option integrator="Euler" noslip_iterations="3" timestep="0.002" cone="pyramidal">
      <flag multiccd="enable" warmstart="enable"/>
    </option>

    <include file="panda_mocap.xml"/>

    <statistic center="0.3 0 0.4" extent="1"/>

    <visual>
      <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
      <rgba haze="0.15 0.25 0.35 1"/>
      <global azimuth="120" elevation="-20"/>
    </visual>

    <asset>
      <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
      <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
      <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
      <material name="window_frame_mat" rgba="0.63 0.67 0.72 1" specular="0.95" shininess="0.65" reflectance="0.35"/>
      <material name="glass_mat" rgba="0.68 0.86 0.95 0.28" specular="0.98" shininess="0.85" reflectance="0.08"/>
      <material name="pickup_station_mat" rgba="0.24 0.28 0.32 1" specular="0.45" shininess="0.40" reflectance="0.15"/>
      <material name="pickup_pad_mat" rgba="0.12 0.16 0.20 1" specular="0.10" shininess="0.10" reflectance="0.02"/>
    </asset>

    <worldbody>
      <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
      <camera name="watching" pos="-1.906515 -1.175593 1.141641" xyaxes="0.515038 -0.857167 0.000000 0.264879 0.159156 0.951057"/>

      <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

      <body name="window_frame" pos="0.6 0.0 0.5">
        <geom name="window_frame_top" type="box" size="0.02 0.42 0.075" pos="0 0 0.255" material="window_frame_mat" condim="6" friction="1 0.5 0.5"/>
        <geom name="window_frame_bottom" type="box" size="0.02 0.42 0.075" pos="0 0 -0.255" material="window_frame_mat" condim="6" friction="1 0.5 0.5"/>
        <geom name="window_frame_left" type="box" size="0.02 0.075 0.18" pos="0 -0.345 0" material="window_frame_mat" condim="6" friction="1 0.5 0.5"/>
        <geom name="window_frame_right" type="box" size="0.02 0.075 0.18" pos="0 0.345 0" material="window_frame_mat" condim="6" friction="1 0.5 0.5"/>
        <site name="target" pos="0 0 0" size="0.02" rgba="1 0 0 0.8" type="sphere"/>
      </body>

      <body name="pickup_station" pos="0.0 -0.60 0.0">
        <geom name="pickup_station_block" type="box" size="0.245 0.315 0.124" pos="0 0 0.124" material="pickup_station_mat" condim="6" friction="1.4 0.4 0.2"/>
        <geom name="pickup_station_guard_front" type="box" size="0.245 0.006 0.025" pos="0 0.309 0.273" material="pickup_pad_mat" condim="6" friction="1.0 0.3 0.1"/>
        <geom name="pickup_station_guard_back" type="box" size="0.245 0.006 0.025" pos="0 -0.309 0.273" material="pickup_pad_mat" condim="6" friction="1.0 0.3 0.1"/>
        <geom name="pickup_station_guard_left" type="box" size="0.006 0.303 0.025" pos="-0.239 0 0.273" material="pickup_pad_mat" condim="6" friction="1.0 0.3 0.1"/>
        <geom name="pickup_station_guard_right" type="box" size="0.006 0.303 0.025" pos="0.239 0 0.273" material="pickup_pad_mat" condim="6" friction="1.0 0.3 0.1"/>
      </body>

      <body name="obj" pos="0.0 -0.60 0.25" quat="1 0 0 0">
        <joint type="free" damping="0.01" name="obj_joint"/>
        <geom name="obj_geom" mass="0.18" type="box" size="0.175 0.265 0.002" material="glass_mat" friction="0.8 0.05 0.01" condim="6"/>
        <site name="obj_site" pos="0 0 0" size="0.01" type="sphere"/>
      </body>
    </worldbody>

    <equality>
      <weld name="obj_grasp_weld" body1="ee_center_body" body2="obj" solref="0.002 1" solimp="0.95 0.99 0.001"/>
    </equality>
</mujoco>
