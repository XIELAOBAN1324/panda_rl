<mujoco model="panda scene">
    <compiler angle="radian" meshdir="./meshes/" autolimits="true"/>

    <option integrator="Euler" noslip_iterations="3" timestep="0.002" cone="pyramidal">
      <flag multiccd="enable" warmstart="enable"/>
    </option>

    <include file="panda_mocap.xml"/>

    <statistic center="0.3 0 0.4" extent="1"/>

    <visual>
      <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
      <rgba haze="0.15 0.25 0.35 1"/>
      <global azimuth="120" elevation="-20"/>
    </visual>

    <asset>
      <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
      <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
      <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
      <material name="window_frame_mat" rgba="0.85 0.25 0.25 1"/>
    </asset>

    <worldbody>
      <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
      <camera name="watching" pos="1.669 -1.154 1.019" xyaxes="0.644 0.765 0.000 -0.250 0.210 0.945"/>

      <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

      <body name="window_frame" pos="0.6 0.0 0.5">
        <geom name="window_frame_top" type="box" size="0.0125 0.20 0.0125" pos="0 0 0.1875" material="window_frame_mat" condim="6" friction="1 0.5 0.5"/>
        <geom name="window_frame_bottom" type="box" size="0.0125 0.20 0.0125" pos="0 0 -0.1875" material="window_frame_mat" condim="6" friction="1 0.5 0.5"/>
        <geom name="window_frame_left" type="box" size="0.0125 0.0125 0.175" pos="0 -0.1875 0" material="window_frame_mat" condim="6" friction="1 0.5 0.5"/>
        <geom name="window_frame_right" type="box" size="0.0125 0.0125 0.175" pos="0 0.1875 0" material="window_frame_mat" condim="6" friction="1 0.5 0.5"/>
        <site name="target" pos="0 0 0" size="0.02" rgba="1 0 0 0.8" type="sphere"/>
      </body>

      <body name="obj" pos="0.42 0.0 0.12" quat="1 0 0 0">
        <joint type="free" damping="0.01" name="obj_joint"/>
        <geom name="obj_geom" mass="0.1" type="box" size="0.02 0.02 0.02" rgba="0.5 0.7 0.5 1" friction="1" condim="6"/>
        <site name="obj_site" pos="0 0 0" size="0.01" type="sphere"/>
      </body>
    </worldbody>

    <equality>
      <weld name="obj_grasp_weld" body1="ee_center_body" body2="obj" solref="0.002 1" solimp="0.95 0.99 0.001"/>
    </equality>
</mujoco>
